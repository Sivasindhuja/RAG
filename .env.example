GEMINI_API_KEY=
CO_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
RAG_INGEST_TOKEN=
RAG_DEFINITION_INTENT_BOOST=false
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
RAG_GENERATION_MODE=gemini
RAG_ALLOW_GEMINI=true

# Task 24 - Isolated Weaviate Cloud experiment (opt-in; default backend remains chroma)
RAG_RETRIEVER_BACKEND=chroma
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=SatcomNgpExp800160
WEAVIATE_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# Optional experimental connection resilience (defaults preserve weaviate-client v4: init=2s, query=30s)
WEAVIATE_INIT_TIMEOUT_S=2
WEAVIATE_QUERY_TIMEOUT_S=30
